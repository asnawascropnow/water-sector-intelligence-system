# ---- Bengaluru Water Intelligence MVP ----
# PostgreSQL + PostGIS connection. Leave unset to use the embedded PGlite database in .data/pglite
# DATABASE_URL=postgres://user:pass@localhost:5432/bengaluru_water
# API_PORT=3001
# WEB_PORT=3000
# Geocoding of imported addresses (OpenStreetMap Nominatim). Set to "none" to disable.
# GEOCODER=nominatim
# GEOCODER_USER_AGENT="BengaluruWaterIntelligence/0.1 (you@example.com)"
# Optional: enables AI extraction for unstructured PDF/DOCX and AI web research in the enrichment agent
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Seed the database with the legacy prototype's Bengaluru organizations on first run (default true)
# SEED_DEMO_DATA=true
# Optional custom basemap tiles (defaults to Esri World Street Map)
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=
