# ---- Bengaluru Water Intelligence MVP ----
# PostgreSQL + PostGIS connection. Leave unset to use the embedded PGlite database in .data/pglite
# DATABASE_URL=postgres://user:pass@localhost:5432/bengaluru_water
# API_PORT=3001
# WEB_PORT=3000
# Geocoding of imported addresses (OpenStreetMap Nominatim). Set to "none" to disable.
# GEOCODER=nominatim
# GEOCODER_USER_AGENT="BengaluruWaterIntelligence/0.1 (you@example.com)"
# Optional: enables AI extraction for unstructured PDF/DOCX and AI web research in the enrichment agent
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Seed the database with the legacy prototype's Bengaluru organizations on first run (default true)
# SEED_DEMO_DATA=true
# Optional custom basemap tiles (defaults to Esri World Street Map)
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_ATTRIBUTION=

# ---- Email outreach (see docs/email-automation.md) ----
# Server-side only: never prefix these with VITE_. Nothing is sent unless EMAIL_DRY_RUN=false.
# EMAIL_DRY_RUN=true
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# Shared secret Brevo sends with every webhook (Authorization: Bearer <token>)
# BREVO_WEBHOOK_TOKEN=
# Best-effort: also blocklist suppressed addresses as Brevo contacts (WSIS's own list is always enforced)
# BREVO_SYNC_SUPPRESSIONS=false
# Sender — must be a sender/domain verified in Brevo
# EMAIL_SENDER_EMAIL=outreach@yourcompany.example
# Defaults to "WSIS Team" in dry-run; required for live sending
# EMAIL_SENDER_NAME="Your Name"
# EMAIL_SENDER_COMPANY="Your Company Pvt Ltd"
# EMAIL_SENDER_ADDRESS="Street, Area, Bengaluru 560001, India"
# Public https URL of this API (unsubscribe links and webhook URLs)
# PUBLIC_BASE_URL=https://wsis.yourcompany.example
# Reply detection via Brevo inbound parsing (subdomain with MX records pointing to Brevo)
# EMAIL_REPLY_DOMAIN=reply.yourcompany.example
# EMAIL_REPLY_FORWARD_TO=sales@yourcompany.example
# EMAIL_LIST_UNSUBSCRIBE_HEADER=true
# Scheduler and safety limits
# EMAIL_SCHEDULER_ENABLED=true
# EMAIL_SCHEDULER_INTERVAL_SECONDS=60
# EMAIL_WORKER_BATCH_SIZE=10
# EMAIL_MAX_SEND_ATTEMPTS=4
# EMAIL_RETRY_BASE_SECONDS=300
# EMAIL_CLAIM_LEASE_SECONDS=600
# EMAIL_DAILY_SEND_LIMIT=100
# EMAIL_MAX_RECIPIENTS_PER_CAMPAIGN=200
# Addresses / @domains allowed to receive "Send test" emails (besides team members' addresses). Does not affect sequences.
# EMAIL_TEST_RECIPIENTS=you@yourcompany.example,@yourcompany.example
# Hard safety restriction: when set, EVERY email (test or sequence) may only go to these addresses / @domains
# EMAIL_RECIPIENT_ALLOWLIST=you@yourcompany.example
# Team roles allowed to approve, activate, resume and send tests
# EMAIL_APPROVER_ROLES=admin,outreach
