# Google Maps Platform API Key
# Get yours at https://console.cloud.google.com/apis/credentials
# Must be a browser-restricted key with Maps JavaScript API enabled
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# Google Maps Map ID
# Create one at https://console.cloud.google.com/google/maps-apis/maps
# Required for AdvancedMarker & Pin components (use a Vector type map)
VITE_GOOGLE_MAPS_MAP_ID=your_map_id_here
